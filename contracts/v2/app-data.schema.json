          }
        },
        "targetPrepServings": { "type": "number" },
        "favorAvailablePantry": { "anyOf": [{ "const": false }, { "const": true }] },
        "lateDayNutritionBias": { "anyOf": [{ "const": false }, { "const": true }] }
      },
      "required": ["mode", "preferredSlots", "targetPrepServings", "favorAvailablePantry"],
      "additionalProperties": false
    },
    "GroceryCategorySetting": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
