          "anyOf": [
            { "const": "Produce" },
            { "const": "Meat & Seafood" },
            { "const": "Dairy" },
            { "const": "Bakery" },
            { "const": "Frozen" },
            { "const": "Pantry" },
            { "const": "Snacks" },
            { "const": "Household" },
            { "const": "Other" },
            { "type": "string" }
          ]
        },
        "sortOrder": { "type": "number" },
        "enabled": { "anyOf": [{ "const": false }, { "const": true }] }
      },
      "required": ["id", "name", "sortOrder", "enabled"],
      "additionalProperties": false
    },
    "GroceryStaple": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "canonicalName": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "category": {
          "anyOf": [
            { "const": "Produce" },
            { "const": "Meat & Seafood" },
            { "const": "Dairy" },
            { "const": "Bakery" },
            { "const": "Frozen" },
            { "const": "Pantry" },
            { "const": "Snacks" },
            { "const": "Household" },
            { "const": "Other" },
            { "type": "string" }
          ]
        },
        "enabled": { "anyOf": [{ "const": false }, { "const": true }] }
      },
      "required": ["id", "name", "canonicalName", "quantity", "unit", "category", "enabled"],
      "additionalProperties": false
    },
    "CalendarFeed": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "anyOf": [{ "const": "canvas" }, { "const": "google" }, { "const": "ics" }] },
        "importMode": { "anyOf": [{ "const": "file" }, { "const": "url" }, { "const": "private-snapshot" }] },
        "url": { "anyOf": [{ "type": "string" }] },
        "enabled": { "anyOf": [{ "const": false }, { "const": true }] },
        "status": { "anyOf": [{ "const": "not-configured" }, { "const": "connected" }, { "const": "error" }] },
        "lastRefresh": { "anyOf": [{ "type": "string" }] },
        "lastImportCount": { "anyOf": [{ "type": "number" }] },
        "lastAssignmentCount": { "anyOf": [{ "type": "number" }] }
      },
      "required": ["id", "name", "kind", "enabled", "status"],
      "additionalProperties": false
    }
  }
